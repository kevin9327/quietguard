<Window x:Class="QuietGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuietGuard"
        Height="640" Width="820"
        MinHeight="520" MinWidth="680"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="QuietGuard" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="조용한 Windows 보안 · 엔진은 Microsoft Defender" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock x:Name="BudgetText" Grid.Column="1" VerticalAlignment="Center"
                 Foreground="{StaticResource Muted}" TextAlignment="Right"/>
    </Grid>

    <Border DockPanel.Dock="Top" Background="{StaticResource Card}" CornerRadius="16" Padding="22" Margin="0,0,0,14"
            BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="HeadlineText" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ok}" Text="상태 확인 중"/>
          <ItemsControl x:Name="ReasonList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Content="빠른 검사" Click="OnQuickScan" Padding="16,8" Margin="0,0,0,8" MinWidth="140"/>
          <Button Content="정의 업데이트" Click="OnUpdate" Padding="16,8" Margin="0,0,0,8" MinWidth="140"/>
          <CheckBox x:Name="BootToggle" Content="시작 시 실행" Checked="OnBootChecked" Unchecked="OnBootUnchecked"/>
        </StackPanel>
      </Grid>
    </Border>

    <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0,0,0,14">
      <Border Background="{StaticResource Card}" CornerRadius="12" Padding="14" Margin="0,0,8,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="실시간 보호" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="RealtimeText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Card}" CornerRadius="12" Padding="14" Margin="4,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="다운로드 검사" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="IoavText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Card}" CornerRadius="12" Padding="14" Margin="4,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="변조 방지" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="TamperText" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Card}" CornerRadius="12" Padding="14" Margin="8,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="정의 버전" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="SignatureText" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <CheckBox x:Name="WatchToggle" Content="다운로드 폴더 감시 (실행 파일만, 조용히 검사)"
                Checked="OnWatchChecked" Unchecked="OnWatchUnchecked"
                VerticalAlignment="Center"/>
      <TextBlock x:Name="ActionText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                 Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    </DockPanel>

    <Border Background="{StaticResource Card}" CornerRadius="12" Padding="16"
            BorderBrush="{StaticResource Line}" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="최근 위협" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="RestoreButton" Click="OnRestore" Padding="12,6" Margin="0,0,8,0"/>
          <Button x:Name="AllowButton" Click="OnAllow" Padding="12,6" Margin="0,0,8,0"/>
          <Button x:Name="RemediateButton" Click="OnRemediate" Padding="12,6"/>
        </StackPanel>
        <ListBox x:Name="ThreatList" BorderThickness="0" Background="Transparent"/>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
