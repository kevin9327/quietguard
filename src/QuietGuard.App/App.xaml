<Application x:Class="QuietGuard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F4F6F3"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#1C2B24"/>
    <SolidColorBrush x:Key="Muted" Color="#5B6B63"/>
    <SolidColorBrush x:Key="Line" Color="#D7E0D9"/>
    <SolidColorBrush x:Key="Ok" Color="#1F7A4D"/>
    <SolidColorBrush x:Key="Warn" Color="#B36B00"/>
    <SolidColorBrush x:Key="Bad" Color="#B42318"/>
    <SolidColorBrush x:Key="Accent" Color="#2A6F5B"/>
  </Application.Resources>
</Application>
